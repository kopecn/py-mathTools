# ==============================
# Python Build / Bytecode Artifacts
# ==============================

# Compiled Python files (bytecode)
__pycache__/
*.py[cod]
*$py.class

# Compiled binary extensions
*.c
*.so
*.pyd
*.dll

# Directory-level compiled artifacts
build/
dist/
develop-eggs/
sdist/
parts/
var/


# ==============================
# Virtual Environments & Dependencies
# ==============================

# General virtual environments (Modern and Classic)
.venv/
# Throwaway clean-room venv for `make testInEnv` (VENV in .env)
.cleanroom-venv/
venv/
env/
.env/

# Specific package manager caches / lock files
poetry.lock
Pipfile.lock
# uv.lock is intentionally NOT committed: this is a library, so we declare version
# ranges (requires-python) and stay on uv's `uv pip` interface, which never writes a
# lockfile (only `uv sync`/`uv lock` do). Ignored as belt-and-suspenders.
uv.lock
# NOTE: requirements.txt and requirements-release.txt are COMMITTED, not ignored. Per the
# dependency BKM pyproject.toml declares dependency NAMES ONLY; the requirements files carry
# the pins + git-based pointers and every install path leans on them. No `lock`/compile step.
# requirements-local.txt is the per-machine local editable sibling overlay (`-e ../sibling`
# lines) consumed by `make uv-sync-local`. Never committed.
requirements-local.txt
# Generic wheel/package info folders
*.egg-info/

# PDK / Environment Specific Cache Folders
.tox/
.nox/
.mypy_cache/

# ==============================
# Tooling and Static Analysis Caches
# ==============================

# Coverage / Testing Reports
.coverage
.coverage.*
htmlcov/

# Pytest cache directory
.pytest_cache/ 

# Mypy specific files
dmypy.json

# Ruff (Linter) cache
.ruff_cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/


