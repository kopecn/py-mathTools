.DS_Store
.AppleDouble
.LSOverride

# Standard VCS/Code Editor folders
# IntelliJ IDEA family
.idea/
# Generic module file
*.iml
# VS Code workspace settings
.vscode/

# Python boilerplate / Framework config
# Django specific local overrides
local_settings.py


